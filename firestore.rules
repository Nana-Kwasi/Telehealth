rules_version = '2';

// NessaHub no longer uses Firestore: the web and mobile apps talk only to the
// NessaHub API (see src/services/firestoreShim.js and authShim.js). The old
// rules allowed public reads of user records and client-side writes that the
// couple-therapy functions trusted, so everything is closed here. Any data
// still in this Firebase project stays readable to project admins in the
// Firebase console, never to clients.
//
// The previous rules are in git history if a migration ever needs them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
