rules_version = '2';
// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isPlatformSuperAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /diagnostic-results/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /homeCare/nurses/{nurseId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == nurseId
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == nurseId;
    }

    match /therapist-profiles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        request.auth.uid == uid
        || isPlatformSuperAdmin()
      );
    }

    // Chat attachments (doctor, medical, therapist, client) — same paths as DoctorMessages
    match /chat_files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /chat_voice/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /chat-media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /chat-audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /chat-files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /client-chats/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
    match /staff-chat/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }

    // Platform super admin: full storage access.
    match /{allPaths=**} {
      allow read, write: if isPlatformSuperAdmin();
    }
  }
}
