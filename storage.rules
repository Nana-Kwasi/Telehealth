rules_version = '2';
// Deploy: firebase deploy --only storage
//
// NessaHub no longer stores files in Firebase Storage: uploads go through the
// NessaHub API (signed object storage). The old rules let any signed-in Firebase
// user read folders such as diagnostic-results, so everything is closed here.
// Files still in the bucket stay available to project admins in the Firebase
// console. The previous rules are in git history.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
